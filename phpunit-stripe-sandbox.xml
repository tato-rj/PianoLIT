<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php" colors="true" cacheResult="false">
    <testsuites>
        <testsuite name="Real Stripe sandbox with isolated local state">
            <directory suffix="Test.php">tests/Sandbox</directory>
        </testsuite>
    </testsuites>
    <php>
        <server name="PIANOLIT_STRIPE_SANDBOX" value="1" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/review-config-not-used.php" force="true"/>
        <server name="APP_URL" value="http://localhost" force="true"/>
        <server name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="CACHE_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SCOUT_DRIVER" value="null" force="true"/>
        <server name="LOG_CHANNEL" value="stderr" force="true"/>
        <server name="BUGSNAG_NOTIFY_RELEASE_STAGES" value="__review_disabled__" force="true"/>
    </php>
</phpunit>
